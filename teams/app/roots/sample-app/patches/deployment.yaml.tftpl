apiVersion: apps/v1
kind: Deployment
metadata:
  name: sample-app
spec:
  template:
    spec:
      containers:
        - name: sample-app
          env:
            - name: SQL_CONNECTION_STRING
              value: "${sql_connection_string}"
            - name: KEY_VAULT_URL
              value: "${key_vault_url}"
            - name: DEMO_SECRET_NAME
              value: "${demo_secret_name}"
