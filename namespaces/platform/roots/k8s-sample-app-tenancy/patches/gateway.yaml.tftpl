apiVersion: networking.istio.io/v1beta1
kind: Gateway
metadata:
  name: sample-app
  namespace: istio-gateway
spec:
  servers:
    - hosts:
        - "sample-app/${hostname}"
      port:
        name: https
        number: 443
        protocol: HTTPS
      tls:
        mode: SIMPLE
        credentialName: sample-app-tls
